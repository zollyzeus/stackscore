# ── GCP / Vertex AI ──────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# Gemini model used for brief / stakeholder / twist / defect generation
VERTEX_MODEL=gemini-2.5-flash

# ── Firebase (Firestore via Admin SDK) ───────────────────────────────────────
FIREBASE_PROJECT_ID=your-gcp-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Google AI (Gemini API key — aistudio.google.com) ─────────────────────────
GEMINI_API_KEY=

# ── Anthropic (Claude judge — lib/judge.ts) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Each role MUST have its own secret in production. PANELIST_SECRET is used as a
# derivation fallback for the others, which means a leak of it compromises all
# three roles — set them all explicitly.
PANELIST_SECRET=change-me-to-a-random-32-char-string
CANDIDATE_SECRET=change-me-to-another-random-32-char-string
ADMIN_SECRET=change-me-to-a-third-random-32-char-string
# Signs public credential attestations served by /api/verify/:slug
CREDENTIAL_SECRET=change-me-to-a-fourth-random-32-char-string
CREDENTIAL_KEY_ID=ss-mvp-1

# ── Role registries (bootstrap seeds; Firestore is the live source) ──────────
# Comma-separated emails.
PANELIST_EMAILS=panelist@example.com
ADMIN_EMAILS=admin@example.com
# Admin routes are additionally IP-gated and FAIL CLOSED: with this unset, /admin
# and /api/admin/* return 403 for everyone. Comma-separated IPs.
ADMIN_IP_ALLOWLIST=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
